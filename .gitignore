# Python
__pycache__/
*.py[cod]
*.egg-info/

# Virtual environments
.venv/
venv/
env/
chronos/                    # your actual venv folder name is "chronos", not ".venv" everywhere

# Jupyter
.ipynb_checkpoints/

# Jupyter notebook outputs (optional — see note below before enabling)
